library(data.table)
library(ranger)
library(caret)     # 這裡只拿來算 R^2 / RMSE（也可不用）
set.seed(42)
#--- 0) 準備 ----
dt <- as.data.table(df_merged)   # 你的資料
library(dplyr)
library(readr)
library(tidyr)
library(ggplot2)
library(tibble)
